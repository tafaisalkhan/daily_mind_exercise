theme_override_fonts/font = ExtResource("2_body_font")
theme_override_colors/font_color = Color(0.176, 0.133, 0.094, 1)
theme_override_font_sizes/font_size = 15
text = "Math Mind respects your privacy.\n\nGAME PROGRESS\nThe game stores level progress, coins, stars, settings, purchases, and privacy consent locally on your device.\n\nDAILY CHALLENGES\nIf enabled, notification permission is used only to remind you about the Daily Challenge. You can disable reminders in your device settings.\n\nADVERTISING\nThe free version may display advertisements. An optional purchase removes banner and interstitial ads; rewarded ads remain available for hints and bonuses. Advertising and billing providers may process device or transaction information under their own policies.\n\nCHILDREN\nMath Mind is designed for a general and family audience. Do not enter personal information into the game.\n\nPURCHASES\nPurchases are processed by the device app store. Math Mind does not receive or store your complete payment-card details.\n\nYOUR CHOICES\nYou can disable notifications, adjust sound effects, or remove locally stored game data through your device settings.\n\nBy selecting the agreement below and pressing Accept, you confirm that you have read and accepted this Privacy Policy."
autowrap_mode = 2

[node name="AgreeCheck" type="CheckButton" parent="Dimmer/Card/Margin/VBox"]
